              "type": "object",
              "properties": {
                "productName": {
                  "example": "any"
                },
                "price": {
                  "example": "0.00"
                },
                "productDescription": {
                  "example": "any"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Product updated"
          },
          "400": {
            "description": "Invalid id format"
          },
          "404": {
            "description": "Product not found"
          }
        }
