    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get all products",
        "responses": {
          "200": {
            "description": "A list of products"
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Create a product",
        "security": [{ "GitHub": ["user"] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "productName": {
                  "example": "any"
                },
                "price": {
                  "example": "0.00"
                },
                "productDescription": {
                  "example": "any"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Product created"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get one product",
        "parameters": [
          {
            "$ref": "#/parameters/ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Product found"
          },
          "400": {
            "description": "Invalid id format"
          },
          "404": {
            "description": "Product not found"
          }
        }
      },
      "put": {
        "tags": ["Products"],
        "summary": "Update a product",
        "security": [{ "GitHub": ["user"] }],
        "parameters": [
          {
            "$ref": "#/parameters/ObjectId"
